{
  "packages": {
    "rustup":     "1.28.2",
    "pkg-config": "latest",
    "openssl": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "cargo-dist": "latest",
    "gcc": "latest",
    "clang": "latest",
    "mold": "latest",
    "cargo-edit": "latest",
    "just": "latest",
    "yarn": "latest",
    "nodejs": "24",
    "cargo-watch": "latest"
  },
  "env": {
    "PKG_CONFIG_PATH": "$DEVBOX_PACKAGES_DIR/lib/pkgconfig"
  },
  "shell": {
    "init_hook": ["rustup default stable", "cargo fetch"],
    "scripts": {
      "server": "RUSTFLAGS=-Awarnings cargo run \"$@\"",
      "zed":    "zeditor ."
    }
  }
}
